# ---------------------------------------------------------------------------
# DocGenie configuration
# Copy to .env and fill in. Every value below has a working default except the
# API key, so the app boots and renders with an empty file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=DocGenie
ORG_NAME=Moneyboxx Finance
ENVIRONMENT=production
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Where uploads, the SQLite database and the embedded vector store live.
# In Docker this is a named volume, so it survives container recreation.
DATA_DIR=./data

# Only used when the frontend is served from a different origin, which is the
# case for `npm run dev`. In the compose stack nginx proxies /api, so requests
# are same-origin and this is not needed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Models ----------------------------------------------------------------
# openai  the real provider
# mock    offline development. No key needed, no network calls. Deterministic
#         hashing embeddings, so retrieval genuinely works, but answers are
#         assembled from the retrieved passages rather than written by a model.
LLM_PROVIDER=openai

LLM_MODEL=gpt-5.6-luna
# Rewrite, rerank, summaries and auto-config. Kept separate so a cheaper tier
# can be slotted in without touching the answering model.
LLM_MODEL_UTILITY=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
TRANSCRIPTION_MODEL=whisper-1

OPENAI_API_KEY=
# Optional. Set for Azure OpenAI or a compatible gateway.
OPENAI_BASE_URL=

LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=3
# json_object works everywhere. json_schema is stricter where the model supports it.
LLM_STRUCTURED_OUTPUT_MODE=json_object

# --- Vector store ----------------------------------------------------------
VECTOR_DB=qdrant
# Set to http://vectordb:6333 in Docker Compose. Leave empty to run qdrant
# embedded on local disk under DATA_DIR, which needs no server.
QDRANT_URL=
QDRANT_API_KEY=
VECTOR_DISTANCE=Cosine

# --- Ingestion -------------------------------------------------------------
INGEST_CONCURRENCY=3
CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=120
CHUNK_MIN_TOKENS=40
EMBED_BATCH_SIZE=64
# One extra model call per chunk. Fully implemented, off by default for cost.
CONTEXTUAL_CHUNKS_LLM=false
DOCUMENT_SUMMARY_WORDS=150
MAX_UPLOAD_MB=500
MAX_VIDEO_MINUTES=60

# --- Retrieval -------------------------------------------------------------
RETRIEVAL_QUERY_VARIANTS=2
RETRIEVAL_TOP_K_PER_QUERY=12
RETRIEVAL_CANDIDATE_POOL=20
RRF_K=60
RERANK_KEEP=6
RERANK_SCORE_THRESHOLD=3.0
NEIGHBOR_EXPANSION=1
CONTEXT_TOKEN_BUDGET=12000
HISTORY_RAW_TURNS=6
MEMORY_FOLD_EVERY_TURNS=8
ENABLE_FOLLOWUPS=true
FOLLOWUP_COUNT=3

# --- Figures ---------------------------------------------------------------
# Images pulled out of PDFs and Word files during ingestion, so an answer can
# show the screenshot a step refers to. A figure is only ever offered when a
# retrieved passage sits on the same page, or under the same heading, as it.
EXTRACT_FIGURES=true
# Anything smaller than this is a bullet, an icon or a logo, not a screenshot.
FIGURE_MIN_WIDTH=120
FIGURE_MIN_HEIGHT=120
FIGURE_MAX_PER_DOCUMENT=120
FIGURE_MAX_PER_ANSWER=4

# --- Translation -----------------------------------------------------------
TRANSLATION_ENABLED=true
# Comma separated code:name pairs. These appear as the language toggle above
# the composer and as the per-answer translate button.
TRANSLATION_LANGUAGES=hi:Hindi
# Keep screen names, buttons and field labels in English, with the meaning in
# brackets on first use. An RM cannot find a button whose name was translated.
TRANSLATION_KEEP_UI_TERMS=true

# --- Zoho Desk -------------------------------------------------------------
# Resolved tickets become indexed learnings. Read-only: nothing is written back.
# Leave the credentials blank and the connector runs on built-in sample tickets,
# which exercises redaction, distillation and indexing without a real desk.
#
# Generate a self-client refresh token in the Zoho API console with the scope
# Desk.tickets.READ,Desk.basic.READ,Desk.settings.READ
ZOHO_DATA_CENTER=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_SYNC_INTERVAL_MINUTES=30
ZOHO_PAGE_SIZE=50
ZOHO_MAX_TICKETS_PER_SYNC=200
ZOHO_REQUEST_TIMEOUT=45
# Removes mobile numbers, emails, PAN, Aadhaar, IFSC, GSTIN and account numbers
# before any ticket text reaches a model or the index. Turning this off sends
# customer identifiers to your provider and stores them in the vector database.
ZOHO_REDACT_PII=true

# --- Usage -----------------------------------------------------------------
USAGE_MONTHLY_MESSAGE_LIMIT=10000

# --- Widget ----------------------------------------------------------------
WIDGET_DEFAULT_ACCENT=#0056AE

# --- Frontend --------------------------------------------------------------
# Empty means same origin, which is correct behind nginx. For `npm run dev`
# set it to http://localhost:8000
VITE_API_BASE_URL=
